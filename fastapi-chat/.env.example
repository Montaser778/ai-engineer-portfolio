GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ALLOWED_ORIGINS=https://eng7montaser.tech,https://montaser778.github.io

# Signs admin session cookies -- generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Neon Postgres connection string (Render's own disk is ephemeral, so this
# must be a real persistent Postgres, not sqlite, in production).
DATABASE_URL=

# Seeds the one owner account on first run only. Change the password via the
# dashboard afterwards -- these env vars are not re-applied once a user
# already exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Fine-grained GitHub PAT scoped to *only* this repo, with Contents:
# Read and write. Used to commit uploaded images and site-text edits.
GITHUB_TOKEN=
GITHUB_REPO=Montaser778/ai-engineer-portfolio
GITHUB_BRANCH=main

# Domain the public GitHub Pages site is actually served from -- used to
# build URLs for uploaded images.
SITE_DOMAIN=eng7montaser.tech
